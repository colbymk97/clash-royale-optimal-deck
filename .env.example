# Anthropic API Key (required)
# Get yours at: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Clash Royale API Key (optional — needed for auto-importing player cards)
# Get yours at: https://developer.clashroyale.com
CLASH_ROYALE_API_KEY=your_clash_royale_api_key_here

# Flask settings
FLASK_SECRET_KEY=change_this_to_a_random_secret
FLASK_DEBUG=false
